#!/bin/sh
# Gate local en el push: los tres componentes con intérprete fijado.
# Procedencia: docs/estandar-diseno-software-github.md §5.4 —checks en verde
# antes del merge—; el CI de este proyecto es local (17-oct-2026: GitHub se
# queda sin créditos para Actions). El gate autoritativo es este script.
set -eu

repo_root="$(git rev-parse --show-toplevel)"
sh "$repo_root/scripts/run-gate.sh"
